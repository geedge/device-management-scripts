{
	"server" : false,
	"datacenter" : "{{ consul.datacenter }}",
	"data_dir" : "/var/consul-internal",
	"encrypt" : "{{ consul.dckey }}",
	"disable_update_check" : true,
	"log_level" : "err",
	"log_file" : "/var/consul-internal/log/consul_internal.log",
	"retry_join" : ["{{ server_ip }}"],
	"retry_interval" : "10s"
}
